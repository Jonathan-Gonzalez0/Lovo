// Exercises: for loop + deeply nested if/else + modulo (a good parser stress test)
// Expected output (Subproject 2), one per line:
//   1, 2, Fizz, 4, Buzz, Fizz, 7, 8, Fizz, Buzz, 11, Fizz, 13, 14, FizzBuzz
for (let i = 1; i <= 15; i = i + 1) {
    if (i % 15 == 0) {
        print("FizzBuzz");
    } else {
        if (i % 3 == 0) {
            print("Fizz");
        } else {
            if (i % 5 == 0) {
                print("Buzz");
            } else {
                print(i);
            }
        }
    }
}
